# Copy to .env (or export in your shell) and restart the server. Everything is optional:
# with nothing set, the app still works with browser speech recognition.

# --- Transcription engines -------------------------------------------------
# OpenAI speech-to-text (Whisper). Audio is sent from the server to OpenAI.
OPENAI_API_KEY=
# whisper-1 (default), gpt-4o-mini-transcribe or gpt-4o-transcribe
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Any OpenAI-compatible endpoint, e.g. a local server that speaks the same API
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Whisper via Transformers.js. Runs on the CPU inside the Node server, fully offline after
# the first run downloads the model from the Hugging Face Hub into WISPR_MODEL_CACHE_DIR.
WISPR_LOCAL_MODEL=onnx-community/whisper-base
# Quantisation, e.g. q8 for a smaller/faster model. Leave empty for the library default.
WISPR_LOCAL_DTYPE=
# Load the local model when the server starts instead of on the first request (1/0)
WISPR_LOCAL_PRELOAD=0

# --- AI polish (Claude) -------------------------------------------------------
# Enables the "Polish" button and auto-polish. Text is sent from the server to Anthropic.
ANTHROPIC_API_KEY=
WISPR_POLISH_MODEL=claude-opus-5-5

# --- Server ---------------------------------------------------------------------
PORT=8787
# Use 0.0.0.0 to reach the app from other devices on your network (browsers require HTTPS or
# localhost for microphone access, so pair this with a reverse proxy or a tunnel). The API has no
# login: anyone who can reach the port can read and delete the history and use your API keys, so put
# an authenticating proxy or tunnel access control in front of it.
HOST=127.0.0.1
# The API only answers requests addressed to localhost, an IP address, or a host name listed here
# (comma-separated; a leading dot such as .example.com also matches subdomains). Add the name you serve
# the app under behind a reverse proxy or tunnel. This blocks DNS-rebinding pages from reaching the API.
WISPR_ALLOWED_HOSTS=
# Where dictations.json and downloaded models live
WISPR_DATA_DIR=data
WISPR_MODEL_CACHE_DIR=data/models
WISPR_MAX_UPLOAD_MB=50
WISPR_MAX_AUDIO_SECONDS=600
# Test-only engine that returns fixed text (used by the end-to-end tests)
WISPR_ENABLE_MOCK_ENGINE=0
